/*index.wxss*/
.container {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding: 32rpx;
}

/*Header*/
.header {
  text-align: center;
  margin-bottom: 48rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1A73E8;
  margin-bottom: 8rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #666;
}

/*Input Section*/
.input-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.input-wrapper {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

.url-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.input-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.paste-btn,
.quality-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.paste-icon {
  font-size: 32rpx;
}

.quality-btn {
  background-color: #e8f0fe;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
}

.quality-label {
  font-size: 24rpx;
  color: #1A73E8;
  font-weight: 500;
}

.fetch-btn {
  width: 100%;
  height: 88rpx;
  background-color: #1A73E8;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.fetch-btn[disabled] {
  background-color: #a8c7fa;
}

/*Platforms Section*/
.platforms-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.platforms-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}

.platform-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.platform-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background-color: #f5f5f5;
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
}

.platform-icon.youtube {
  background-color: #ff0000;
}

.platform-icon.tiktok {
  background-color: #000;
}

.platform-icon.instagram {
  background-color: #e4405f;
}

.platform-icon.twitter {
  background-color: #1da1f2;
}

.platform-icon.facebook {
  background-color: #1877f2;
}

.platform-icon.vimeo {
  background-color: #1ab7ea;
}

.platform-icon.twitch {
  background-color: #9146ff;
}

.platform-icon.reddit {
  background-color: #ff4500;
}

.platform-name {
  font-size: 22rpx;
  color: #666;
}

/*Recent Section*/
.recent-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.recent-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.recent-item {
  background-color: #e8f0fe;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
}

.recent-name {
  font-size: 24rpx;
  color: #1A73E8;
}

/*Modal*/
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.modal-header {
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.picker-content {
  padding: 24rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
}

.modal-btn.cancel {
  background-color: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background-color: #1A73E8;
  color: #fff;
}
